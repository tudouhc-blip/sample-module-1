<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Module 1 | Understanding the Framework as a Whole</title>
  <style>
    :root {
      --primary: #0f5c7a;
      --primary-dark: #0b4459;
      --primary-soft: #eef7fb;
      --accent: #f2b544;
      --accent-soft: #fff6df;
      --bg: #f5f7fb;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --border: #d9e1ea;
      --success: #18794e;
      --danger: #b42318;
      --shadow: 0 12px 30px rgba(14, 42, 71, 0.08);
      --radius-lg: 22px;
      --radius-md: 16px;
      --radius-sm: 12px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Segoe UI", Arial, Helvetica, sans-serif;
      background: linear-gradient(180deg, #f7f9fc 0%, #f1f5fa 100%);
      color: var(--text);
      line-height: 1.6;
    }

    .page {
      max-width: 1240px;
      margin: 0 auto;
      padding: 24px;
    }

    .hero {
      background: linear-gradient(135deg, var(--primary) 0%, #2b7d9d 100%);
      color: #fff;
      border-radius: 28px;
      padding: 32px;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: "";
      position: absolute;
      right: -40px;
      top: -40px;
      width: 220px;
      height: 220px;
      background: rgba(255,255,255,0.08);
      border-radius: 50%;
    }

    .hero h1 {
      margin: 0 0 8px;
      font-size: 2rem;
      position: relative;
      z-index: 2;
    }

    .hero p {
      margin: 0;
      max-width: 860px;
      font-size: 1rem;
      opacity: 0.96;
      position: relative;
      z-index: 2;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
      position: relative;
      z-index: 2;
    }

    .chip {
      background: rgba(255,255,255,0.14);
      border: 1px solid rgba(255,255,255,0.18);
      color: #fff;
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 0.92rem;
    }

    .topbar {
      margin-top: 22px;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(8px);
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: var(--shadow);
      padding: 18px 20px;
      position: sticky;
      top: 14px;
      z-index: 40;
    }

    .progress-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 12px;
    }

    .progress-title {
      font-weight: 700;
      color: var(--primary-dark);
    }

    .progress-percent {
      font-weight: 700;
      color: var(--primary);
    }

    .progress-track {
      width: 100%;
      height: 12px;
      background: #e7eef5;
      border-radius: 999px;
      overflow: hidden;
      position: relative;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--accent) 0%, #ffd66f 100%);
      border-radius: 999px;
      transition: width 0.55s ease;
      position: relative;
    }

    .progress-fill::after {
      content: "";
      position: absolute;
      right: 0;
      top: 0;
      width: 42px;
      height: 100%;
      background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.35) 100%);
    }

    .tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 16px;
    }

    .tab-btn {
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text);
      padding: 10px 14px;
      border-radius: 999px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .tab-btn:hover {
      background: #f6fbfd;
      color: var(--primary);
      border-color: #bcd3dd;
    }

    .tab-btn.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
      box-shadow: 0 8px 20px rgba(15,92,122,0.18);
    }

    .layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 22px;
      margin-top: 22px;
    }

    .panel {
      display: none;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow);
      padding: 28px;
      animation: fadeUp 0.35s ease;
    }

    .panel.active {
      display: block;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .section-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 20px;
    }

    .section-head h2 {
      margin: 0 0 6px;
      color: var(--primary);
      font-size: 1.55rem;
    }

    .section-head p {
      margin: 0;
      color: var(--muted);
      max-width: 900px;
    }

    .section-badge {
      white-space: nowrap;
      background: var(--primary-soft);
      color: var(--primary);
      border: 1px solid #d5e7ef;
      padding: 8px 12px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.92rem;
    }

    .callout {
      background: linear-gradient(180deg, #f6fbfe 0%, #eef7fb 100%);
      border: 1px solid #d6e7ef;
      border-left: 5px solid var(--primary);
      padding: 18px;
      border-radius: 16px;
      margin: 18px 0 24px;
    }

    .callout strong {
      color: var(--primary-dark);
    }

    .mini-grid-2,
    .mini-grid-3,
    .mini-grid-4 {
      display: grid;
      gap: 16px;
    }

    .mini-grid-2 { grid-template-columns: repeat(2, 1fr); }
    .mini-grid-3 { grid-template-columns: repeat(3, 1fr); }
    .mini-grid-4 { grid-template-columns: repeat(4, 1fr); }

    .info-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
      box-shadow: 0 8px 18px rgba(18, 52, 77, 0.04);
    }

    .info-card h3,
    .info-card h4 {
      margin-top: 0;
      margin-bottom: 8px;
      color: var(--primary);
    }

    .info-card p:last-child {
      margin-bottom: 0;
    }

    .formula-box {
      background: linear-gradient(135deg, #fff8e6 0%, #fffdf6 100%);
      border: 1px solid #f2d48c;
      border-radius: 18px;
      padding: 18px;
      margin-top: 10px;
      font-size: 1.05rem;
    }

    .formula-big {
      font-size: 1.7rem;
      font-weight: 800;
      color: #9a6900;
      margin-bottom: 8px;
    }

    .flip-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-top: 14px;
    }

    .flip-card {
      perspective: 1000px;
      min-height: 240px;
    }

    .flip-card-inner {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 240px;
      transition: transform 0.7s;
      transform-style: preserve-3d;
      cursor: pointer;
    }

    .flip-card.flipped .flip-card-inner,
    .flip-card:hover .flip-card-inner {
      transform: rotateY(180deg);
    }

    .flip-face {
      position: absolute;
      width: 100%;
      height: 100%;
      min-height: 240px;
      backface-visibility: hidden;
      border-radius: 20px;
      padding: 20px;
      border: 1px solid var(--border);
      box-shadow: 0 8px 18px rgba(18, 52, 77, 0.05);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .flip-front {
      background: linear-gradient(180deg, #ffffff 0%, #f8fbfd 100%);
    }

    .flip-back {
      background: linear-gradient(180deg, #eef7fb 0%, #ffffff 100%);
      transform: rotateY(180deg);
    }

    .flip-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: var(--primary-soft);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .flip-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 8px;
    }

    .flip-hint {
      font-size: 0.88rem;
      color: var(--muted);
      margin-top: 12px;
    }

    .level-card {
      background: linear-gradient(180deg, #fff 0%, #fbfdff 100%);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
    }

    .level-card h4 {
      margin: 0 0 8px;
      color: var(--primary);
    }

    .dual-cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin-top: 16px;
    }

    .matrix-wrap {
      overflow-x: auto;
      margin-top: 16px;
      border-radius: 16px;
      border: 1px solid var(--border);
    }

    table {
      width: 100%;
      min-width: 760px;
      border-collapse: collapse;
      background: #fff;
    }

    th, td {
      border-bottom: 1px solid var(--border);
      border-right: 1px solid var(--border);
      padding: 14px;
      text-align: left;
      vertical-align: top;
    }

    th:last-child, td:last-child {
      border-right: none;
    }

    tr:last-child td {
      border-bottom: none;
    }

    th {
      background: #f2f8fb;
      color: var(--primary-dark);
      font-weight: 800;
    }

    .quiz-item {
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
      background: #fff;
      margin-bottom: 14px;
    }

    .quiz-item strong {
      color: var(--primary-dark);
    }

    .quiz-option {
      display: block;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 11px 12px;
      margin-top: 10px;
      cursor: pointer;
      transition: all 0.2s ease;
      background: #fff;
    }

    .quiz-option:hover {
      background: #f8fbfd;
      border-color: #c9dce6;
    }

    .quiz-option input {
      margin-right: 8px;
    }

    .feedback {
      margin-top: 10px;
      font-weight: 700;
      font-size: 0.95rem;
    }

    .feedback.correct {
      color: var(--success);
    }

    .feedback.incorrect {
      color: var(--danger);
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    label {
      display: block;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--primary-dark);
    }

    input[type="text"],
    select,
    textarea {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px 14px;
      font: inherit;
      color: var(--text);
      background: #fff;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    .goal-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin: 14px 0 18px;
    }

    .goal-item {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      background: #fff;
    }

    .goal-item label {
      margin: 0;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
    }

    details {
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 14px 16px;
      background: #fff;
      margin-bottom: 10px;
    }

    summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--primary-dark);
    }

    .button-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 16px;
    }

    .btn {
      border: none;
      border-radius: 999px;
      padding: 11px 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 0.95rem;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 10px 20px rgba(15,92,122,0.18);
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: #fff;
      color: var(--primary);
      border: 1px solid #bfd3dd;
    }

    .btn-secondary:hover {
      background: #f6fbfd;
    }

